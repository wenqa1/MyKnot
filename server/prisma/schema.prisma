generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String?  @unique
  email     String   @unique
  name      String?
  avatar    String?
  password  String?
  role      String   @default("user")
  disabled  Boolean  @default(false)
  spaceId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space           Space?   @relation(fields: [spaceId], references: [id])
  profile         Profile?
  events          Event[]
  scheduleConfig  ScheduleConfig?
  scheduleItems   ScheduleItem[]
  periodConfig    PeriodConfig?
  periodRecords   PeriodRecord[]
  galleryImages      GalleryImage[]
  galleryAlbums      GalleryAlbum[]
  notificationConfig NotificationConfig?
}

model Space {
  id                    Int       @id @default(autoincrement())
  inviteCode            String    @unique
  relationshipStartDate DateTime?
  myName                String?
  partnerName           String?
  createdAt             DateTime  @default(now())
  users                 User[]
}

model SmtpConfig {
  id        Int      @id @default(autoincrement())
  host      String   @default("")
  port      Int      @default(587)
  user      String   @default("")
  pass      String   @default("")
  fromEmail String   @default("")
  fromName  String   @default("MyKnot")
  secure    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Profile {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  relationshipStartDate DateTime
  myName                String?
  partnerName           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id               Int      @id @default(autoincrement())
  userId           Int
  name             String
  date             DateTime
  calendarType     String   @default("solar")
  lunarMonth       Int?
  lunarDay         Int?
  lunarIsLeapMonth Boolean  @default(false)
  time             String?
  startTime        String?
  endTime          String?
  recurrence       String   @default("yearly")
  icon             String
  description      String   @default("")
  color            String   @default("bg-pink-100 text-pink-600")
  tag              String   @default("MEMORY")
  sortOrder        Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model ScheduleConfig {
  id        Int    @id @default(autoincrement())
  userId    Int    @unique
  daysJson  String
  timesJson String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduleItem {
  id        Int    @id @default(autoincrement())
  userId    Int
  dayIndex  Int
  timeIndex Int
  subject   String
  person    String
  duration  Int    @default(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PeriodConfig {
  id         Int @id @default(autoincrement())
  userId     Int @unique
  cycleDays  Int @default(28)
  periodDays Int @default(5)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PeriodRecord {
  id        Int       @id @default(autoincrement())
  userId    Int
  startDate DateTime
  endDate   DateTime?
  note      String?
  symptoms  String    @default("[]")
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startDate])
}

model GalleryAlbum {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images GalleryImage[]

  @@index([userId])
}

model GalleryImage {
  id           Int      @id @default(autoincrement())
  userId       Int
  filename     String
  originalName String
  mimeType     String
  width        Int
  height       Int
  size         Int
  albumId      Int?
  caption      String   @default("")
  createdAt    DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  album GalleryAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model NotificationConfig {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique

  // Channel toggles
  emailEnabled      Boolean  @default(false)
  barkToken         String   @default("")
  barkEnabled       Boolean  @default(false)
  serverChanKey     String   @default("")
  serverChanEnabled Boolean  @default(false)
  webhookUrl        String   @default("")
  webhookEnabled    Boolean  @default(false)
  dingTalkUrl       String   @default("")
  dingTalkEnabled   Boolean  @default(false)
  weComUrl          String   @default("")
  weComEnabled      Boolean  @default(false)

  // Event type toggles
  notifyOnEvent      Boolean @default(true)
  notifyOnPeriod     Boolean @default(true)
  notifyOnAnniversary Boolean @default(true)

  // Timing
  advanceDays Int    @default(1)
  notifyTime  String @default("08:00")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  refId     String
  channels  String
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([userId, type, refId])
}
