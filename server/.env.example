PORT=3001
HOST=0.0.0.0
JWT_SECRET=your-secret-key-here
NODE_ENV=development

# SQLite (本地开发)
DATABASE_URL=file:./data/knot.db

# MySQL (生产部署)
# 1. 将上方 DATABASE_URL 注释掉
# 2. 修改 prisma/schema.prisma: provider = "mysql"
# 3. 使用下方连接字符串:
# DATABASE_URL=mysql://user:password@localhost:3306/myknot

# Admin 账号 (用于 seed 脚本)
ADMIN_EMAIL=admin@myknot.local
